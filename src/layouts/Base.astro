---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SITE_TAGLINE, OG_BASE_URL } from '../config';

interface Props {
  title: string;
  description?: string;
  /** Error pages (404): never index. */
  noindex?: boolean;
  /**
   * og:image path — ALWAYS resolved against Astro.site into an absolute URL.
   * Contract PINNED (spec FI-339 rev 2): relative og:image values are dropped
   * silently by social crawlers (Facebook/X/Zalo). Default: /og-default.png.
   */
  ogImage?: string;
  /** og:type — 'website' everywhere except blog post pages, which pass 'article'. */
  ogType?: 'website' | 'article';
  /** article:published_time — ISO timestamp; blog post pages pass it. */
  publishedTime?: string;
  /**
   * og:image:alt carve-out (spec FI-349 rev 2 — ADDITIVE): per-post alt text
   * for the hero tile. Default keeps the previous behavior unchanged —
   * `${SITE_NAME} — ${SITE_TAGLINE}`.
   */
  ogImageAlt?: string;
  /**
   * article:author — display name string; blog posts pass it (VU-5 SF-1,
   * ADDITIVE like the ogImageAlt carve-out). Rendered only when set, so
   * every other page keeps the exact previous head.
   */
  articleAuthor?: string;
  /** article:tag — one meta per tag; blog posts pass the entry tags. */
  articleTags?: string[];
}

const {
  title,
  description = SITE_TAGLINE,
  noindex = false,
  ogImage = '/og-default.png',
  ogType = 'website',
  publishedTime,
  ogImageAlt = `${SITE_NAME} — ${SITE_TAGLINE}`,
  articleAuthor,
  articleTags,
} = Astro.props;

/**
 * Locale URL mapping (prefixDefaultLocale: false):
 *   EN canonical  /docs/x        <->  VI  /vi/docs/x
 *   EN root       /              <->  VI  /vi/
 * If a VI page does not exist, hreflang still points at the mapped URL —
 * VI routes are generated from the same slug contract, so a missing VI page
 * means the slug is missing in both locales (contract violation, not fallback).
 *
 * Canonical (SF-5, FI-298): self-referencing per locale — per Google guidance,
 * a non-self canonical can cause the hreflang cluster to be ignored. The
 * hreflang annotations below still cross-link the EN <-> VI pair.
 */
const { pathname } = Astro.url;
const isVi = pathname === '/vi' || pathname.startsWith('/vi/');
const canonicalPath = isVi ? (pathname.replace(/^\/vi/, '') || '/') : pathname;
const viPath = canonicalPath === '/' ? '/vi/' : `/vi${canonicalPath}`;
const fullTitle = title.includes(SITE_NAME) ? title : `${title} — ${SITE_NAME}`;
/**
 * og:locale pair (VU-5 SF-1) — derived from pathname like the hreflang block
 * above, no per-page prop. og protocol uses underscore format (vi_VN); the
 * alternate is the other half of the EN <-> VI pair.
 */
const ogLocale = isVi ? 'vi_VN' : 'en-US';
const ogLocaleAlternate = isVi ? 'en-US' : 'vi_VN';
---

<!doctype html>
<html lang={isVi ? 'vi' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(pathname || '/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(canonicalPath, Astro.site)} />
    <link rel="alternate" hreflang="vi" href={new URL(viPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(canonicalPath, Astro.site)} />
    <!-- Open Graph + Twitter card (FI-339 SF-1; VU-5 SF-1 completes the contract).
         og:url mirrors canonical (SITE_URL). og:image resolves against
         OG_BASE_URL (image-host fallback — wakii.xyz is 404 until the owner
         attaches the domain; flip OG_BASE_URL to SITE_URL then). See
         docs/knowledge/runbooks/link-preview-domain.md. -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(pathname || '/', Astro.site)} />
    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {articleTags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:image" content={new URL(ogImage, OG_BASE_URL)} />
    <!-- og-default + every hero tile are PNG (SF-2 pins 1200×630 PNG tiles). -->
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Twitter reads name= attributes — property= mirrors are not guaranteed. -->
    <meta name="twitter:image" content={new URL(ogImage, OG_BASE_URL)} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} blog`} href="/rss.xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
