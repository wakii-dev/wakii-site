---
/**
 * Landing — structure locked to direction-c.html (Terminal Mono, user-approved).
 * Rendered for both locales: / (EN) and /vi/ (VI) pass their string map.
 * Copy is PLACEHOLDER — SF-2 owns real landing copy.
 */
import type { LandingStrings } from '../i18n/landing';
import { REPO_URL, DOC_SLUGS } from '../config';

interface Props {
  strings: LandingStrings;
}
const { strings } = Astro.props;
const t = strings;
const quickstartHref = `/docs/${DOC_SLUGS[0]}`;
---

<header class="hero">
  <div class="wrap">
    <div class="term">
      <div class="term-bar">
        <span class="tl"></span><span class="tl"></span><span class="tl"></span>
        <span class="title">{t.hero.termTitle}</span>
      </div>
      <div class="term-body" data-typein>
        <div class="ln cmd">{`wakii ./my-project`}</div>
        {t.hero.boot.map((line) => <div class="ln out-ok" set:html={line.replace(/(done|xong|loaded|enabled|~\/\.claude)/g, '<span class="ok">$1</span>')} />)}
        <div class="ln last cmd cursor-line" data-cmd>{t.hero.lastCmd}</div>
      </div>
    </div>

    <div class="kicker">{t.hero.kicker}</div>
    <h1>{t.hero.headlineBefore}<span class="hl">{t.hero.headlineHighlight}</span><span class="cursor"> </span></h1>
    <p class="tagline">
      {t.hero.tagline}<code>{t.hero.taglineCode}</code>,{t.lang === 'vi' ? ' bật sẵn mặc định.' : ' enabled by default.'}
      {t.lang === 'vi'
        ? 'Mô tả một ý tưởng — pipeline chạy: plan, agents song song, verify gates, một PR sạch.'
        : 'Describe an idea and the pipeline runs: plan, parallel agents, verify gates, one clean PR.'}
    </p>
    <div class="cta-row">
      <a href={REPO_URL} class="btn btn-primary">{t.hero.ctaPrimary}</a>
      <a href={quickstartHref} class="btn btn-ghost">{t.hero.ctaGhost}</a>
    </div>
    <div class="hero-stats">
      {t.hero.stats.map((s) => (
        <div class="hs"><div class="v">{s.v}</div><div class="k">{s.k}</div></div>
      ))}
    </div>
  </div>
</header>

<section class="zero">
  <div class="wrap zero-grid">
    {t.zero.map((z) => (
      <div class="zero-item">
        <div class="status"><em>{z.status}</em></div>
        <h3>{z.title}</h3>
        <p>{z.desc}</p>
      </div>
    ))}
  </div>
</section>

<section class="section" id="features">
  <div class="wrap">
    <div class="section-head">
      <div class="kicker">{t.features.kicker}</div>
      <h2>{t.features.title}</h2>
      <p>{t.features.sub}</p>
    </div>
    <div class="feat-list">
      {t.features.items.map((f, i) => (
        <div class="feat">
          <div class="id">sf<b>.00{i + 1}</b><br />{f.cat}</div>
          <div><h3>{f.name}</h3><p>{f.desc}</p></div>
          <div class="flag">{f.flag}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="flow" id="workflow">
  <div class="wrap">
    <div class="section-head">
      <div class="kicker">{t.workflow.kicker}</div>
      <h2>{t.workflow.title}</h2>
    </div>
    <div class="pipe">
      {t.workflow.stages.map((stage, i) => (
        <>
          {i > 0 && <span class="arrow">→</span>}
          {stage === 'parallel SFs' || stage === 'SF song song' ? (
            <span class="hot">{stage}</span>
          ) : stage.includes('verify') || stage.includes('cổng') ? (
            <span class="st gate">{stage}</span>
          ) : (
            <span class="st">
              {stage}
              {stage.startsWith('plan') || stage.startsWith('kế hoạch') ? (
                <span class="plan-note">{t.workflow.planNote}</span>
              ) : null}
            </span>
          )}
        </>
      ))}
    </div>
    <div class="pipe-legend">{t.workflow.legend}</div>
    <div class="flow-note">{t.workflow.note}</div>
  </div>
</section>

<section class="quick" id="quickstart">
  <div class="wrap">
    <div class="section-head">
      <div class="kicker">{t.quickstart.kicker}</div>
      <h2>{t.quickstart.title}</h2>
    </div>
    <div class="quick-steps">
      {t.quickstart.steps.map((step, i) => (
        <div class="qs">
          <div class="qn"><b>{step.n}</b> {step.comment}</div>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
          <div class="cmd">{step.cmd}</div>
        </div>
      ))}
    </div>
    <p class="quick-more">{t.quickstart.more} <a href={quickstartHref}>{t.quickstart.moreLink}</a></p>
  </div>
</section>

<section class="faq" id="faq">
  <div class="wrap">
    <div class="section-head">
      <div class="kicker">{t.faq.kicker}</div>
      <h2>{t.faq.title}</h2>
    </div>
    {t.faq.items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <div class="ans">{item.a}</div>
      </details>
    ))}
  </div>
</section>

<style>
  /* ===== HERO ===== */
  .hero {
    padding: var(--section-pad) 0 88px;
  }
  .term {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(69, 224, 168, 0.04);
    overflow: hidden;
    margin-bottom: 72px;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-deep);
  }
  .term-bar .tl {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .term-bar .tl:nth-child(1) { background: #e5654f; }
  .term-bar .tl:nth-child(2) { background: var(--warn); }
  .term-bar .tl:nth-child(3) { background: var(--accent); }
  .term-bar .title {
    margin-left: 12px;
    font-size: 12px;
    color: var(--text-faint);
  }
  .term-body {
    padding: 32px 36px 40px;
    font-size: 14px;
  }
  .term-body .ln {
    margin-bottom: 10px;
    color: var(--text-faint);
    white-space: pre-wrap;
  }
  .term-body .cmd {
    color: var(--text);
  }
  .term-body .cmd::before {
    content: '$ ';
    color: var(--accent);
  }
  .term-body .out-ok {
    color: var(--text-dim);
  }
  .term-body .ok {
    color: var(--accent);
  }
  .term-body .last {
    margin-top: 22px;
    margin-bottom: 0;
  }
  .term-body .cursor-line::after {
    content: '▊';
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  .hero h1 {
    font-size: clamp(34px, 5.5vw, 62px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
  }
  .hero h1 .hl {
    color: var(--accent);
  }
  .hero h1 .cursor::after {
    content: '▊';
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
    font-weight: 400;
  }
  .hero .tagline {
    margin-top: 26px;
    color: var(--text-dim);
    max-width: 640px;
    font-size: 15px;
  }
  .hero .tagline code {
    color: var(--accent);
    background: var(--accent-soft);
    padding: 1px 6px;
    border-radius: var(--radius);
  }
  .cta-row {
    margin-top: 44px;
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    align-items: center;
  }
  .btn {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    padding: 14px 28px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.15s ease;
  }
  .btn::before {
    content: '> ';
    font-weight: 400;
    opacity: 0.6;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--bg-deep);
  }
  .btn-primary:hover {
    box-shadow: 0 0 32px rgba(69, 224, 168, 0.35);
    transform: translateY(-1px);
  }
  .btn-ghost {
    border: 1px solid var(--border-strong);
    color: var(--text-dim);
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .hero-stats {
    margin-top: 48px;
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    max-width: 720px;
  }
  .hs {
    flex: 1;
    padding: 16px 24px;
    border-right: 1px solid var(--border);
    min-width: 140px;
  }
  .hs:last-child {
    border-right: none;
  }
  .hs .v {
    font-size: 22px;
    font-weight: 700;
    color: var(--accent);
  }
  .hs .k {
    font-size: 11.5px;
    color: var(--text-faint);
    margin-top: 2px;
  }

  /* ===== ZERO-SETUP ===== */
  .zero {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--bg-raised);
    padding: 44px 0;
  }
  .zero-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .zero-item {
    padding: 12px 32px;
    border-left: 1px dashed var(--border-strong);
  }
  .zero-item:first-child {
    border-left: none;
    padding-left: 0;
  }
  .zero-item .status {
    font-size: 12px;
    margin-bottom: 12px;
  }
  .zero-item .status::before {
    content: '[ OK ] ';
    color: var(--accent);
  }
  .zero-item .status em {
    color: var(--text-faint);
    font-style: normal;
  }
  .zero-item h3 {
    font-size: 15.5px;
    font-weight: 700;
  }
  .zero-item p {
    font-size: 13px;
    color: var(--text-dim);
    margin-top: 6px;
  }

  /* ===== FEATURES ===== */
  .section {
    padding: var(--section-pad) 0;
  }
  .section-head h2 {
    font-size: clamp(26px, 3.5vw, 38px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .section-head h2::before {
    content: '// ';
    color: var(--accent);
    font-weight: 400;
  }
  .section-head p {
    margin-top: 14px;
    color: var(--text-dim);
    font-size: 14.5px;
    max-width: 580px;
  }
  .section-head {
    margin-bottom: 48px;
  }
  .feat-list {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .feat {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    gap: 28px;
    padding: 26px 28px;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    align-items: baseline;
    transition: background 0.15s ease;
  }
  .feat:last-child {
    border-bottom: none;
  }
  .feat:hover {
    background: var(--accent-soft);
  }
  .feat .id {
    font-size: 12.5px;
    color: var(--text-faint);
  }
  .feat .id b {
    color: var(--accent);
    font-weight: 500;
  }
  .feat h3 {
    font-size: 16.5px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .feat p {
    font-size: 13.5px;
    color: var(--text-dim);
  }
  .feat .flag {
    font-size: 11.5px;
    color: var(--accent);
    border: 1px solid var(--border-strong);
    padding: 4px 10px;
    border-radius: var(--radius);
    white-space: nowrap;
    background: var(--bg-deep);
  }

  /* ===== WORKFLOW ===== */
  .flow {
    padding: var(--section-pad) 0;
    background: var(--bg-raised);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .pipe {
    font-size: 13.5px;
    line-height: 2.4;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-deep);
    padding: 32px 36px;
    overflow-x: auto;
    white-space: nowrap;
  }
  .pipe .st {
    color: var(--text);
    font-weight: 500;
  }
  .pipe .plan-note {
    color: var(--text-faint);
    font-weight: 400;
  }
  .pipe .arrow {
    color: var(--text-faint);
    padding: 0 6px;
  }
  .pipe .hot {
    color: var(--accent);
    font-weight: 700;
  }
  .pipe .gate::before {
    content: '[';
    color: var(--text-faint);
  }
  .pipe .gate::after {
    content: ']';
    color: var(--text-faint);
  }
  .pipe-legend {
    margin-top: 24px;
    font-size: 12.5px;
    color: var(--text-faint);
  }
  .flow-note {
    margin-top: 40px;
    border-left: 2px solid var(--accent);
    padding: 8px 0 8px 20px;
    font-size: 13.5px;
    color: var(--text-dim);
    max-width: 640px;
  }

  /* ===== QUICKSTART ===== */
  .quick {
    padding: var(--section-pad) 0;
  }
  .quick-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .qs {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-deep);
    padding: 24px;
    transition: border-color 0.15s ease;
  }
  .qs:hover {
    border-color: var(--accent);
  }
  .qs .qn {
    font-size: 11.5px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
  }
  .qs .qn b {
    color: var(--accent);
  }
  .qs h3 {
    font-size: 15.5px;
    font-weight: 700;
    margin-top: 10px;
  }
  .qs p {
    font-size: 13px;
    color: var(--text-dim);
    margin-top: 6px;
  }
  .qs .cmd {
    margin-top: 16px;
    font-size: 12.5px;
    color: var(--accent);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 10px 14px;
    border-radius: var(--radius);
    white-space: nowrap;
    overflow-x: auto;
  }
  .qs .cmd::before {
    content: '$ ';
    color: var(--text-faint);
  }
  .quick-more {
    margin-top: 32px;
    font-size: 13.5px;
    color: var(--text-dim);
  }
  .quick-more::before {
    content: '-> ';
    color: var(--accent);
  }
  .quick-more a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dashed var(--accent);
  }

  /* ===== FAQ ===== */
  .faq {
    padding: 88px 0;
    background: var(--bg-raised);
    border-top: 1px solid var(--border);
  }
  details {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-deep);
    margin-bottom: 12px;
    overflow: hidden;
  }
  summary {
    padding: 18px 24px;
    cursor: pointer;
    list-style: none;
    font-size: 14.5px;
    font-weight: 500;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  summary::before {
    content: '? ';
    color: var(--accent);
    font-weight: 700;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    color: var(--accent);
    font-size: 16px;
  }
  details[open] summary::after {
    content: '-';
  }
  details .ans {
    padding: 0 24px 20px 52px;
    color: var(--text-dim);
    font-size: 13.5px;
    font-family: var(--font-sans);
  }

  @media (max-width: 900px) {
    .zero-grid,
    .quick-steps {
      grid-template-columns: 1fr;
    }
    .zero-item {
      border-left: none;
      padding-left: 0;
      padding: 12px 0;
    }
    .feat {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .feat .flag {
      justify-self: start;
    }
    .term-body {
      padding: 24px 20px 32px;
    }
  }
</style>

<script>
  // Boot-log type-in — hero only, runs once (~1.6s total), skipped when the
  // user prefers reduced motion. Without JS the full log is visible (SEO/no-JS).
  const body = document.querySelector('[data-typein]');
  if (body && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lines = Array.from(body.querySelectorAll('.ln'));
    const total = 1600; // ms budget for the whole sequence
    const textLens = lines.map((l) => (l.textContent ?? '').length);
    const totalChars = textLens.reduce((a, b) => a + b, 0);
    const perChar = total / totalChars;

    const originals = lines.map((l) => l.innerHTML);
    lines.forEach((l) => (l.innerHTML = '&nbsp;'));
    const last = lines[lines.length - 1];
    last.classList.remove('cursor-line');

    let li = 0;
    let ci = 0;
    const plain = lines.map((l) => {
      const tmp = document.createElement('div');
      tmp.innerHTML = originals[lines.indexOf(l)];
      return tmp.textContent ?? '';
    });
    // strip the CSS-injected "$ " prefix for cmd lines when re-typing? No — it is
    // CSS ::before content, so textContent never includes it. Safe to type raw.

    function tick() {
      if (li >= lines.length) {
        last.classList.add('cursor-line');
        lines.forEach((l, i) => (l.innerHTML = originals[i]));
        return;
      }
      ci += 1;
      if (ci >= plain[li].length) {
        lines[li].textContent = plain[li];
        li += 1;
        ci = 0;
        setTimeout(tick, 40);
        return;
      }
      lines[li].textContent = plain[li].slice(0, ci);
      setTimeout(tick, perChar);
    }
    setTimeout(tick, 250);
  }
</script>
