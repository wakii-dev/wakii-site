---
/**
 * Mockup kit — TerminalBoot: terminal window with traffic lights + boot log.
 * Pure prop-driven renderer (SF-2 reuses; content lives in i18n/landing.ts).
 * Type-in runs once (~1.6s), skipped for prefers-reduced-motion / no-JS
 * (full log rendered statically in markup).
 */
interface Props {
  title: string;
  cmd: string;
  lines: string[];
  lastCmd: string;
  /** highlight words inside boot lines (locale-aware) */
  okWords?: string[];
}
const { title, cmd, lines, lastCmd, okWords = ['done', 'xong', 'loaded', 'enabled', 'ready', '~/.claude'] } = Astro.props;
/** split a boot line into text/ok segments (template-rendered → scoped + escaped) */
const seg = (line: string) =>
  line
    .split(new RegExp(`(${okWords.map((w) => w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'g'))
    .map((text, i) => ({ text, ok: i % 2 === 1 }));
---

<div class="term" data-terminal>
  <div class="term-bar">
    <span class="tl"></span><span class="tl"></span><span class="tl"></span>
    <span class="title">{title}</span>
  </div>
  <div class="term-body" data-typein>
    <div class="ln cmd">{cmd}</div>
    {lines.map((line) => (
      <div class="ln out">
        {seg(line).map((p) => (p.ok ? <span class="ok">{p.text}</span> : p.text))}
      </div>
    ))}
    <div class="ln last cmd cursor-line" data-cmd>{lastCmd}</div>
  </div>
</div>

<style>
  .term {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-cell);
    background: var(--bg-raised);
    box-shadow: 0 32px 90px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(69, 224, 168, 0.05);
    overflow: hidden;
    will-change: transform;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--panel);
  }
  .term-bar .tl {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .term-bar .tl:nth-child(1) { background: var(--red); }
  .term-bar .tl:nth-child(2) { background: var(--warn); }
  .term-bar .tl:nth-child(3) { background: var(--accent); }
  .term-bar .title {
    margin-left: 12px;
    font-size: 12px;
    color: var(--text-faint);
  }
  .term-body {
    padding: 26px 30px 32px;
    font-size: 13px;
  }
  .term-body .ln {
    margin-bottom: 9px;
    color: var(--text-faint);
    white-space: pre-wrap;
  }
  .term-body .cmd { color: var(--text); }
  .term-body .cmd::before {
    content: '$ ';
    color: var(--accent);
  }
  .term-body .out { color: var(--text-dim); }
  .term-body .ok { color: var(--accent); }
  .term-body .last {
    margin-top: 18px;
    margin-bottom: 0;
  }
  .term-body .cursor-line::after {
    content: '▊';
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @media (max-width: 640px) {
    .term-body {
      padding: 20px 18px 26px;
      font-size: 12px;
    }
  }
</style>

<script>
  // Type-in per [data-terminal] root — runs once, total budget ~1.6s.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-terminal]').forEach((root) => {
    const body = root.querySelector<HTMLElement>('[data-typein]');
    if (!body || reduce) return;
    const lines = Array.from(body.querySelectorAll<HTMLElement>('.ln'));
    const last = lines[lines.length - 1];
    const originals = lines.map((l) => l.innerHTML);
    const plain = originals.map((h) => {
      const tmp = document.createElement('div');
      tmp.innerHTML = h;
      return tmp.textContent ?? '';
    });
    const totalChars = plain.reduce((a, b) => a + b.length, 0);
    if (!totalChars) return;
    const perChar = 1600 / totalChars;

    lines.forEach((l) => (l.innerHTML = '&nbsp;'));
    last.classList.remove('cursor-line');

    let li = 0;
    let ci = 0;
    function tick() {
      if (!body) return;
      if (li >= lines.length) {
        lines.forEach((l, i) => (l.innerHTML = originals[i]));
        last.classList.add('cursor-line');
        return;
      }
      ci += 1;
      if (ci >= plain[li].length) {
        lines[li].textContent = plain[li];
        li += 1;
        ci = 0;
        setTimeout(tick, 40);
        return;
      }
      lines[li].textContent = plain[li].slice(0, ci);
      setTimeout(tick, perChar);
    }
    setTimeout(tick, 250);
  });
</script>
