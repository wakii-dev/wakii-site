<script>
  // ---- motion contract (FI-304 / VU-9 hand-off): the shared util does all
  // entrance work; initMotion() once per page, nothing custom. The block
  // below is this page's SINGLE progressive-enhancement script (D6).
  import { initMotion } from '../motion';
  initMotion();

  // ---- D6 OS-detect — HIGHLIGHT ONLY ----
  // Rule: macOS visitor → macOS card, Windows → Windows card, Android →
  // mobile card; Linux/unknown → no highlight at all. The cue is
  // non-color: aria-current="true" on the card + a text chip (".chip.on")
  // in the label meta. Buttons are NEVER hidden or reordered. Inside the
  // macOS card there is NO arch highlight (both buttons keep equal
  // weight, arm64 first) — the only arch refinement is the arm64 tag
  // swap via navigator.userAgentData.getHighEntropyValues(['architecture'])
  // (fail-silent, default stays arm64). Detection reads
  // navigator.platform / userAgentData.platform ONLY (plus the Android
  // user-agent disambiguation — navigator.platform misses it); no other
  // fingerprinting. No-JS: nothing here runs — the rendered page is
  // already complete.
  {
    const nav = navigator as Navigator & {
      userAgentData?: {
        platform?: string;
        getHighEntropyValues?: (hints: string[]) => Promise<{ architecture?: string }>;
      };
    };
    const plat = `${nav.userAgentData?.platform ?? ''} ${navigator.platform ?? ''}`;
    const ua = navigator.userAgent || '';
    let os: 'macos' | 'windows' | 'android' | null = null;
    if (/mac/i.test(plat)) {
      // iPadOS reports MacIntel — an iPad is not a macOS download target.
      os = navigator.maxTouchPoints > 1 ? null : 'macos';
    } else if (/win/i.test(plat)) {
      os = 'windows';
    } else if (/android/i.test(ua)) {
      os = 'android'; // navigator.platform says "Linux armv8…" on Android
    }
    if (os) {
      const card = document.querySelector<HTMLElement>(`[data-os="${os}"]`);
      if (card) {
        card.classList.add('os-hit');
        card.setAttribute('aria-current', 'true');
        card.querySelector<HTMLElement>('.chip')?.classList.add('on');
        if (os === 'macos') {
          nav.userAgentData
            ?.getHighEntropyValues?.(['architecture'])
            .then((hint) => {
              if (hint && hint.architecture === 'x86') {
                card.querySelectorAll<HTMLElement>('[data-arch-tag]').forEach((tag) => {
                  tag.classList.toggle('on', tag.dataset.archTag === 'archYours');
                });
              }
            })
            .catch(() => {});
        }
      }
    }
  }
</script>
