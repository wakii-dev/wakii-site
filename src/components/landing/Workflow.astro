---
/**
 * Landing — Workflow pipeline section. Extracted from Landing.astro (SF-1
 * componentize, FI-295) — markup + styles verbatim. SF-4 owns the deepen
 * wiring (keys already in LandingStrings.workflowDeep).
 */
import type { LandingStrings } from '../../i18n/landing';

interface Props {
  strings: LandingStrings;
}
const { strings } = Astro.props;
const t = strings;
---

<section class="flow" id="workflow">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="kicker">{t.workflow.kicker}</div>
      <h2>{t.workflow.title}</h2>
      <p>{t.workflow.sub}</p>
    </div>
    <div class="pipe">
      {t.workflow.stages.map((stage, i) => (
        <>
          {i > 0 && <span class="arrow">→</span>}
          {stage === 'parallel SFs' || stage === 'SF song song' ? (
            <span class="hot">{stage}</span>
          ) : (
            <span class="st">
              {stage}
              {stage.startsWith('plan') || stage.startsWith('kế hoạch') ? (
                <span class="plan-note">{t.workflow.planNote}</span>
              ) : null}
            </span>
          )}
        </>
      ))}
    </div>
    <div class="pipe-legend">{t.workflow.legend}</div>
    <div class="flow-note">{t.workflow.note}</div>
  </div>
</section>

<style>
  .flow {
    padding: var(--section-pad) 0;
    background: var(--bg-raised);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .pipe {
    font-size: 13.5px;
    line-height: 2.4;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: var(--radius-cell);
    background: var(--panel);
    padding: 30px 34px;
    overflow-x: auto;
    white-space: nowrap;
  }
  .pipe .st {
    color: var(--text);
    font-weight: 500;
  }
  .pipe .plan-note {
    color: var(--text-faint);
    font-weight: 400;
  }
  .pipe .arrow {
    color: var(--text-faint);
    padding: 0 6px;
  }
  .pipe .hot {
    color: var(--accent);
    font-weight: 700;
  }
  .pipe-legend {
    margin-top: 20px;
    font-size: 12.5px;
    color: var(--text-faint);
  }
  .pipe-legend::before {
    content: '▮ ';
    color: var(--accent);
  }
  .flow-note {
    margin-top: 36px;
    border-left: 2px solid var(--accent);
    padding: 8px 0 8px 20px;
    font-size: 13.5px;
    color: var(--text-dim);
    max-width: 660px;
  }
</style>
