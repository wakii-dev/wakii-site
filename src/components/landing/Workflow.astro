---
/**
 * Landing — Workflow pipeline section. Extracted from Landing.astro (SF-1
 * componentize, FI-295) — markup + styles verbatim. SF-4 owns the deepen
 * wiring (keys already in LandingStrings.workflowDeep).
 */
import type { LandingStrings } from '../../i18n/landing';

interface Props {
  strings: LandingStrings;
}
const { strings } = Astro.props;
const t = strings;
---

<section class="flow" id="workflow">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="kicker">{t.workflow.kicker}</div>
      <h2>{t.workflow.title}</h2>
      <p>{t.workflow.sub}</p>
    </div>
    <div class="pipe">
      {t.workflow.stages.map((stage, i) => (
        <>
          {i > 0 && <span class="arrow">→</span>}
          {stage === 'parallel SFs' || stage === 'SF song song' ? (
            <span class="hot">{stage}</span>
          ) : (
            <span class="st">
              {stage}
              {stage.startsWith('plan') || stage.startsWith('kế hoạch') ? (
                <span class="plan-note">{t.workflow.planNote}</span>
              ) : null}
            </span>
          )}
        </>
      ))}
    </div>
    <div class="pipe-legend">{t.workflow.legend}</div>
    <div class="agents reveal">
      <div class="agents-title">{t.workflowDeep.agentsTitle}</div>
      <p class="agents-intro">{t.workflowDeep.agentsIntro}</p>
    </div>
    <div class="gates reveal">
      <div class="gates-title">{t.workflowDeep.gatesTitle}</div>
      <p class="gates-intro">{t.workflowDeep.gatesIntro}</p>
      <div class="gate-grid">
        {t.workflowDeep.gates.map((gate) => (
          <div class="gate">
            <span class="gate-id">{gate.id}</span>
            <div class="gate-label">{gate.label}</div>
            <p class="gate-desc">{gate.desc}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="flow-note">{t.workflow.note}</div>
  </div>
</section>

<style>
  .flow {
    padding: var(--section-pad) 0;
    background: var(--bg-raised);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .pipe {
    font-size: 13.5px;
    line-height: 2.4;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: var(--radius-cell);
    background: var(--panel);
    padding: 30px 34px;
    overflow-x: auto;
    white-space: nowrap;
  }
  .pipe .st {
    color: var(--text);
    font-weight: 500;
  }
  .pipe .plan-note {
    color: var(--text-faint);
    font-weight: 400;
  }
  .pipe .arrow {
    color: var(--text-faint);
    padding: 0 6px;
  }
  .pipe .hot {
    color: var(--accent);
    font-weight: 700;
  }
  .pipe-legend {
    margin-top: 20px;
    font-size: 12.5px;
    color: var(--text-faint);
  }
  .pipe-legend::before {
    content: '▮ ';
    color: var(--accent);
  }
  .agents {
    margin-top: 36px;
    border-left: 2px solid var(--accent);
    padding: 8px 0 8px 20px;
    max-width: 660px;
  }
  .agents-title {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: lowercase;
    color: var(--accent);
  }
  .agents-intro {
    margin-top: 8px;
    font-size: 13.5px;
    color: var(--text-dim);
  }
  .gates {
    margin-top: 36px;
    max-width: 660px;
  }
  .gates-title {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: lowercase;
    color: var(--accent);
  }
  .gates-intro {
    margin-top: 8px;
    font-size: 13.5px;
    color: var(--text-dim);
  }
  .gate-grid {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    max-width: none;
  }
  .gate {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-cell);
    background: var(--panel);
    padding: 16px 18px;
  }
  .gate-id {
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.08em;
  }
  .gate-label {
    margin-top: 8px;
    color: var(--text);
    font-weight: 600;
    font-size: 13.5px;
    line-height: 1.4;
  }
  .gate-desc {
    margin-top: 6px;
    color: var(--text-dim);
    font-size: 12.5px;
    line-height: 1.6;
  }
  .flow-note {
    margin-top: 36px;
    border-left: 2px solid var(--accent);
    padding: 8px 0 8px 20px;
    font-size: 13.5px;
    color: var(--text-dim);
    max-width: 660px;
  }
</style>
