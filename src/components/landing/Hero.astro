---
/**
 * Landing — Hero section. Extracted from Landing.astro (SF-1 componentize,
 * FI-295) — markup + styles verbatim.
 */
import type { LandingStrings } from '../../i18n/landing';
import { REPO_URL } from '../../config';

interface Props {
  strings: LandingStrings;
}
const { strings } = Astro.props;
const t = strings;
const prefix = t.lang === 'vi' ? '/vi' : '';
const docsHref = `${prefix}/docs/getting-started/`;
// VU-9 SF-2 CTA split (hand-off D8 PIN): primary → /download, ghost → repo;
// the old guide CTA demotes to a text link inside the micro line.
const downloadHref = `${prefix}/download`;
---

<header class="hero" data-tilt-host>
  <div class="wrap hero-grid">
    <div>
      <div class="kicker">{t.hero.kicker}</div>
      <h1>{t.hero.headlineBefore}<span class="hl">{t.hero.headlineHighlight}</span><span class="cursor"> </span></h1>
      <p class="tagline">
        {t.hero.tagline}<code>{t.hero.taglineCode}</code>,{t.lang === 'vi' ? ' bật sẵn mặc định.' : ' enabled by default.'}
        {t.lang === 'vi'
          ? 'Mô tả một ý tưởng — pipeline chạy: plan, agents song song, verify gates, một PR sạch.'
          : 'Describe an idea and the pipeline runs: plan, parallel agents, verify gates, one clean PR.'}
      </p>
      <div class="cta-row">
        <a href={downloadHref} class="btn btn-primary">{t.hero.ctaDownload}</a>
        <a href={REPO_URL} class="btn btn-ghost">{t.hero.ctaBuild}</a>
      </div>
      <p class="cta-micro">
        {t.hero.ctaMicro}
        <span class="sep" aria-hidden="true">·</span>
        <a class="guide" href={docsHref}>{t.hero.ctaGhost}</a>
      </p>
      <div class="hero-stats">
        {t.hero.stats.map((s) => (
          <div class="hs"><div class="v">{s.v}</div><div class="k">{s.k}</div></div>
        ))}
      </div>
    </div>
    <div>
      <div class="hero-visual" data-hero-term>
        <figure class="app-frame">
          <div class="app-titlebar" aria-hidden="true">
            <span class="tl"></span><span class="tl"></span><span class="tl"></span>
            <span class="t">{t.hero.windowTitle}</span>
            <span class="live">{t.hero.liveBadge}</span>
          </div>
          <img
            src="/hero-team-workflow.png"
            width="1120"
            height="592"
            alt={t.hero.imgAlt}
            decoding="async"
          />
        </figure>
        <div class="hero-caption">
          <span class="chip">{t.hero.captionChip}</span>
          <span class="meta">{t.hero.shotMeta}</span>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    padding: 80px 0 72px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(rgba(69, 224, 168, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(69, 224, 168, 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 20%, black 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 60% 20%, black 20%, transparent 75%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 56px;
    align-items: center;
    position: relative;
    perspective: 1600px;
  }
  .hero h1 {
    font-size: clamp(34px, 4.6vw, 58px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
  }
  .hero h1 .hl {
    color: var(--accent);
  }
  .hero h1 .cursor::after {
    content: '▊';
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
    font-weight: 400;
  }
  .hero .tagline {
    margin-top: 22px;
    color: var(--text-dim);
    max-width: 520px;
    font-size: 15px;
  }
  .hero .tagline code {
    color: var(--accent);
    background: var(--accent-soft);
    padding: 1px 6px;
    border-radius: var(--radius);
  }
  .cta-row {
    margin-top: 38px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .btn {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    padding: 14px 28px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: var(--radius-btn);
    transition: all 0.15s ease;
  }
  .btn::before {
    content: '> ';
    font-weight: 400;
    opacity: 0.6;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--bg-deep);
  }
  .btn-primary:hover {
    box-shadow: 0 0 36px rgba(69, 224, 168, 0.35);
    transform: translateY(-1px);
  }
  .btn-ghost {
    border: 1px solid var(--border-strong);
    color: var(--text-dim);
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  /* micro line under the CTA split — "free · open source · unsigned build"
     + the demoted guide text-link (ctaGhost kept for GetWakii gw-b) */
  .cta-micro {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .cta-micro .sep {
    color: var(--text-faint);
    margin: 0 8px;
  }
  .cta-micro .guide {
    color: var(--text-dim);
    text-decoration: none;
    border-bottom: 1px dashed var(--border-strong);
    padding-bottom: 1px;
  }
  .cta-micro .guide:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .hero-stats {
    margin-top: 44px;
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    max-width: 560px;
  }
  .hs {
    flex: 1;
    padding: 14px 20px;
    border-right: 1px solid var(--border);
    min-width: 110px;
  }
  .hs:last-child {
    border-right: none;
  }
  .hs .v {
    font-size: 20px;
    font-weight: 700;
    color: var(--accent);
  }
  .hs .k {
    font-size: 11px;
    color: var(--text-faint);
    margin-top: 2px;
  }

  /* hero visual — design A "The Window" (docs/mockups/handoff-spec-a.md):
     app-frame chrome around the real shot; motion.ts mouse-tilt still binds
     the .hero-visual[data-hero-term] wrapper. Tokens only — no new values. */
  .app-frame {
    margin: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-cell);
    background: var(--bg-raised);
    box-shadow:
      0 32px 90px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(69, 224, 168, 0.05);
    overflow: hidden;
  }
  .app-titlebar {
    display: flex;
    align-items: center;
    padding: 11px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--panel);
    font-family: var(--font-mono);
  }
  .app-titlebar .tl {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .app-titlebar .tl:nth-child(1) {
    background: var(--red);
  }
  .app-titlebar .tl:nth-child(2) {
    background: var(--warn);
  }
  .app-titlebar .tl:nth-child(3) {
    background: var(--accent);
  }
  .app-titlebar .t {
    font-size: 12px;
    color: var(--text-faint);
    margin-left: 12px;
  }
  .app-titlebar .live {
    margin-left: auto;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    border-radius: 999px;
    padding: 2px 10px;
  }
  .app-titlebar .live::before {
    content: '● ';
  }
  .app-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-top: 14px;
    font-family: var(--font-mono);
  }
  .hero-caption .chip {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 5px 14px;
  }
  .hero-caption .chip::before {
    content: '● ';
    color: var(--accent);
    font-size: 8px;
  }
  .hero-caption .meta {
    font-size: 10.5px;
    color: var(--text-faint);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  @media (max-width: 1020px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
