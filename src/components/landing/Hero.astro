---
/**
 * Landing — Hero section. Extracted from Landing.astro (SF-1 componentize,
 * FI-295) — markup + styles verbatim.
 */
import type { LandingStrings } from '../../i18n/landing';
import { REPO_URL } from '../../config';
import TerminalBoot from '../mockups/TerminalBoot.astro';

interface Props {
  strings: LandingStrings;
}
const { strings } = Astro.props;
const t = strings;
const docsHref = (t.lang === 'vi' ? '/vi' : '') + '/docs/getting-started';
---

<header class="hero" data-tilt-host>
  <div class="wrap hero-grid">
    <div>
      <div class="kicker">{t.hero.kicker}</div>
      <h1>{t.hero.headlineBefore}<span class="hl">{t.hero.headlineHighlight}</span><span class="cursor"> </span></h1>
      <p class="tagline">
        {t.hero.tagline}<code>{t.hero.taglineCode}</code>,{t.lang === 'vi' ? ' bật sẵn mặc định.' : ' enabled by default.'}
        {t.lang === 'vi'
          ? 'Mô tả một ý tưởng — pipeline chạy: plan, agents song song, verify gates, một PR sạch.'
          : 'Describe an idea and the pipeline runs: plan, parallel agents, verify gates, one clean PR.'}
      </p>
      <div class="cta-row">
        <a href={REPO_URL} class="btn btn-primary">{t.hero.ctaPrimary}</a>
        <a href={docsHref} class="btn btn-ghost">{t.hero.ctaGhost}</a>
      </div>
      <div class="hero-stats">
        {t.hero.stats.map((s) => (
          <div class="hs"><div class="v">{s.v}</div><div class="k">{s.k}</div></div>
        ))}
      </div>
    </div>
    <div>
      <div data-hero-term>
        <TerminalBoot title={t.hero.termTitle} cmd="wakii ./my-project" lines={t.hero.boot} lastCmd={t.hero.lastCmd} />
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    padding: 80px 0 72px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(rgba(69, 224, 168, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(69, 224, 168, 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 20%, black 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 60% 20%, black 20%, transparent 75%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 56px;
    align-items: center;
    position: relative;
    perspective: 1600px;
  }
  .hero h1 {
    font-size: clamp(34px, 4.6vw, 58px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
  }
  .hero h1 .hl {
    color: var(--accent);
  }
  .hero h1 .cursor::after {
    content: '▊';
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
    font-weight: 400;
  }
  .hero .tagline {
    margin-top: 22px;
    color: var(--text-dim);
    max-width: 520px;
    font-size: 15px;
  }
  .hero .tagline code {
    color: var(--accent);
    background: var(--accent-soft);
    padding: 1px 6px;
    border-radius: var(--radius);
  }
  .cta-row {
    margin-top: 38px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .btn {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    padding: 14px 28px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: var(--radius-btn);
    transition: all 0.15s ease;
  }
  .btn::before {
    content: '> ';
    font-weight: 400;
    opacity: 0.6;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--bg-deep);
  }
  .btn-primary:hover {
    box-shadow: 0 0 36px rgba(69, 224, 168, 0.35);
    transform: translateY(-1px);
  }
  .btn-ghost {
    border: 1px solid var(--border-strong);
    color: var(--text-dim);
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .hero-stats {
    margin-top: 44px;
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    max-width: 560px;
  }
  .hs {
    flex: 1;
    padding: 14px 20px;
    border-right: 1px solid var(--border);
    min-width: 110px;
  }
  .hs:last-child {
    border-right: none;
  }
  .hs .v {
    font-size: 20px;
    font-weight: 700;
    color: var(--accent);
  }
  .hs .k {
    font-size: 11px;
    color: var(--text-faint);
    margin-top: 2px;
  }

  @media (max-width: 1020px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
