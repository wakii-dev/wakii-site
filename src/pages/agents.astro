---
/**
 * /agents — Showcase Agents + Skills (CEO request 2026-11-07).
 * Data: src/data/agents-skills.ts — auto-generated from the orca repo kit
 * (READ-ONLY cross-read), never hand-edited. Static showcase, no API.
 * Design language mirrors /skills (Bento Catalog, SF-2 direction B):
 * token-driven dark theme, pill/inline bg → --accent-soft, radius → --radius-cell,
 * motion via shared initMotion() only.
 */
import Base from '../layouts/Base.astro';
import { agents, kitSkills, repoSkills, stats } from '../data/agents-skills';
import { agentFlows, type AgentFlowStep } from '../data/agent-flows';

/** Agent category grouping — order fixed for the page narrative. */

/** Agent category grouping — order fixed for the page narrative. */
const catMeta: Record<string, { label: string; blurb: string }> = {
  execution: { label: 'execution', blurb: 'The builders — every write to the codebase goes through one of these.' },
  review: { label: 'review', blurb: 'The adversarial layer — spec, plan, diff, and gate review before anything lands.' },
  ops: { label: 'ops', blurb: 'The operators — running the stack, the loops, and the rescues when they stall.' },
  knowledge: { label: 'knowledge', blurb: 'The memory — confirmed business rules and the project knowledge base.' },
  infra: { label: 'infra', blurb: 'The platform — CI, compose, nginx, and everything under the services.' },
};
const catOrder = ['execution', 'review', 'ops', 'knowledge', 'infra'];

const skillSources = [
  { key: 'kit', label: 'kit skills', list: kitSkills, blurb: 'Shipped inside the Wakii kit — installed with the plugin, on by default.' },
  { key: 'repo', label: 'repo skills', list: repoSkills, blurb: 'Live in the open-source repo — build from source and read along.' },
] as const;

/* ---- modal swimlane (hướng C) — build-time SVG layout ---- */
const LANE_H = 76;
const NODE_W = 164;
const NODE_H = 44;
const X0 = 100;
const DX = 190;

/** Generic per-category flow for agents whose entry has no specific tracks. */
const GENERIC_TRACKS: Record<string, AgentFlowStep[]> = {
  execution: [
    { lane: 'Captain', label: 'dispatch task' },
    { lane: 'Executor', label: 'implement + test' },
    { lane: 'Review', label: 'gate verify' },
    { lane: 'Captain', label: 'report back' },
  ],
  review: [
    { lane: 'Trigger', label: 'artifact ready' },
    { lane: 'Reviewer', label: 'read + grade' },
    { lane: 'Output', label: 'findings' },
  ],
  ops: [
    { lane: 'Trigger', label: 'ops signal' },
    { lane: 'Operator', label: 'act + verify' },
    { lane: 'Output', label: 'status' },
  ],
  knowledge: [
    { lane: 'Captain', label: 'ask' },
    { lane: 'Analyst', label: 'look up rule' },
    { lane: 'Output', label: 'confirmed' },
  ],
  infra: [
    { lane: 'Trigger', label: 'infra signal' },
    { lane: 'Platform', label: 'edit + verify' },
    { lane: 'Output', label: 'stack green' },
  ],
};

const flowOf = (a: (typeof agents)[number]) => agentFlows[a.id];
const isFallback = (a: (typeof agents)[number]) => !flowOf(a)?.tracks?.length;
const tracksOf = (a: (typeof agents)[number]): AgentFlowStep[] =>
  flowOf(a)?.tracks?.length ? flowOf(a)!.tracks! : GENERIC_TRACKS[flowOf(a)?.category ?? a.category];
const laneNames = (steps: AgentFlowStep[]) => [...new Set(steps.map((s) => s.lane))];
const laneY = (lane: string, lanes: string[]) => lanes.indexOf(lane) * LANE_H;
const nodePos = (steps: AgentFlowStep[], lanes: string[]) =>
  steps.map((s, i) => ({ x: X0 + i * DX, y: laneY(s.lane, lanes) + (LANE_H - NODE_H) / 2 }));
const svgW = (steps: AgentFlowStep[]) => X0 + steps.length * DX - (DX - NODE_W) + 24;
const svgH = (lanes: string[]) => lanes.length * LANE_H;
const edgePath = (from: { x: number; y: number }, to: { x: number; y: number }) => {
  const x1 = from.x + NODE_W;
  const y1 = from.y + NODE_H / 2;
  const x2 = to.x - 4;
  const y2 = to.y + NODE_H / 2;
  if (from.y === to.y) return `M${x1},${y1} L${x2},${y2}`;
  return `M${x1},${y1} C${x1 + 26},${y1} ${x2 - 26},${y2} ${x2},${y2}`;
};
---

<Base title="agents" description={`The Wakii team in the open: ${stats.agents} agents, ${stats.totalSkills} skills, ${stats.provides} kit provides, ${stats.eccRules} ECC coding rules. Meet the captain, the builders, the reviewers, and every skill they can draw on.`}>
  <header class="ag-hero">
    <div class="wrap">
      <div class="kicker">the team</div>
      <h1>Agents + skills,<br /><span class="hl">in the open.</span></h1>
      <p class="sub">
        Wakii ships a full agent team, not a model in a terminal. Every agent,
        every skill, every rule — generated straight from the kit source. No
        black boxes.
      </p>
      <div class="hero-stats">
        <div class="hs"><div class="v">{stats.agents}</div><div class="k">agents</div></div>
        <div class="hs"><div class="v">{stats.totalSkills}</div><div class="k">skills</div></div>
        <div class="hs"><div class="v">{stats.provides}</div><div class="k">kit provides</div></div>
        <div class="hs"><div class="v">{stats.eccRules}</div><div class="k">ECC rules</div></div>
      </div>
    </div>
  </header>

  <section class="section" id="agents">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>agents</h2>
        <p>{stats.agents} agents, grouped by what they owe the team. Captain takes the CEO's order; everyone else builds, reviews, or keeps the lights on.</p>
      </div>
      {
        catOrder.map((cat) => {
          const meta = catMeta[cat];
          const list = agents.filter((a) => a.category === cat);
          if (!meta || list.length === 0) return null;
          return (
            <div class="cat-block">
              <div class="cat-head" data-reveal>
                <h3>
                  {meta.label} <span class="count">({list.length})</span>
                </h3>
                <p>{meta.blurb}</p>
              </div>
              <div class="grid">
                {list.map((a) => (
                  <button type="button" class="card agent-card" role="button" data-reveal data-agent={a.id} aria-haspopup="dialog">
                    <div class="card-top">
                      <span class="display">{a.display || a.name}</span>
                      <span class="pill">{a.id}</span>
                    </div>
                    <p class="desc">{a.desc}</p>
                  </button>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  {/* 28 native dialogs — one per agent, opened via showModal() (hướng C swimlane) */}
  {
    agents.map((a) => {
      const fb = isFallback(a);
      const cat = flowOf(a)?.category ?? a.category;
      const steps = tracksOf(a);
      const lanes = laneNames(steps);
      const pos = nodePos(steps, lanes);
      const w = svgW(steps);
      const h = svgH(lanes);
      const name = a.display || a.name;
      return (
        <dialog class="lane-modal" id={`agent-modal-${a.id}`} aria-label={`Agent flow: ${name}`}>
          <div class="lm-head">
            <div class="lm-title">
              <h3 class="lm-name">{name}</h3>
              <span class="pill">{a.id}</span>
            </div>
            <button type="button" class="lm-close" aria-label="Close dialog">
              esc ✕
            </button>
          </div>
          <div class="lm-body">
            <p class="lm-caption">
              {fb ? (
                <>
                  Generic <b>{cat}</b> flow — steps read left to right, lanes group the actors.
                </>
              ) : (
                <>
                  Flow of <b>{name}</b> — steps read left to right, lanes group the actors.
                </>
              )}
            </p>
            <div class="lm-svg-wrap" data-flow-fallback={fb ? cat : undefined}>
              <svg
                class="sl-svg swimlane"
                viewBox={`0 0 ${w} ${h}`}
                role="img"
                aria-label={`Swimlane diagram: ${name} flow across ${lanes.length} lanes`}
              >
                <defs>
                  <marker id={`arr-${a.id}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                    <path d="M0,0 L10,5 L0,10 z" class="sl-arrow" />
                  </marker>
                </defs>
                {lanes.map((lane, li) => (
                  <>
                    <rect
                      x="0"
                      y={li * LANE_H}
                      width={w}
                      height={LANE_H}
                      class={li % 2 ? 'lane-bg alt' : 'lane-bg'}
                      data-track={lane}
                    />
                    <text x="12" y={li * LANE_H + LANE_H / 2 + 4} class="lane-label">
                      {lane}
                    </text>
                  </>
                ))}
                {steps.map((s, i) => (
                  <>
                    {i > 0 && <path d={edgePath(pos[i - 1], pos[i])} class="sl-edge" marker-end={`url(#arr-${a.id})`} />}
                    <rect x={pos[i].x} y={pos[i].y} width={NODE_W} height={NODE_H} rx="8" class="sl-node" />
                    <circle cx={pos[i].x + 14} cy={pos[i].y + 14} r="8" class="sl-num-bg" />
                    <text x={pos[i].x + 14} y={pos[i].y + 17} text-anchor="middle" class="sl-num">
                      {i + 1}
                    </text>
                    <text x={pos[i].x + 28} y={pos[i].y + 26} class="sl-label">
                      {s.label}
                    </text>
                  </>
                ))}
              </svg>
            </div>
          </div>
          <div class="lm-foot">
            <span>mobile: the swimlane keeps its viewBox and scrolls sideways</span>
            <span>
              <kbd>Esc</kbd> closes
            </span>
          </div>
        </dialog>
      );
    })
  }

  <section class="section" id="skills">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>skills</h2>
        <p>{stats.totalSkills} skills across two homes: {stats.kitSkills} ship inside the kit, {stats.repoSkills} live in the repo. Same format — a SKILL.md that says when to reach for it.</p>
      </div>
      {
        skillSources.map((src) => (
          <div class="cat-block">
            <div class="cat-head" data-reveal>
              <h3>
                {src.label} <span class="count">({src.list.length})</span>
              </h3>
              <p>{src.blurb}</p>
            </div>
            <div class="grid skill-grid">
              {src.list.map((s) => (
                <div class="card skill-card" data-reveal>
                  <div class="card-top">
                    <span class="display sm">{s.name}</span>
                  </div>
                  <p class="desc clamp">{s.desc}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  /* ---- hero (same DNA as /skills) ---- */
  .ag-hero {
    padding: 76px 0 60px;
    position: relative;
    overflow: hidden;
  }
  .ag-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(rgba(69, 224, 168, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(69, 224, 168, 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 10%, black 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 10%, black 20%, transparent 75%);
  }
  .ag-hero .wrap {
    position: relative;
  }
  .kicker {
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 0.14em;
    text-transform: lowercase;
  }
  .kicker::before {
    content: '// ';
    color: var(--text-faint);
  }
  h1 {
    margin-top: 14px;
    font-size: clamp(30px, 4.4vw, 54px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    max-width: 760px;
  }
  .hl {
    color: var(--accent);
  }
  .sub {
    margin-top: 20px;
    color: var(--text-dim);
    max-width: 620px;
    font-size: 15px;
    font-family: var(--font-sans);
  }
  .hero-stats {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
    max-width: 640px;
  }
  .hs {
    flex: 1;
    padding: 14px 20px;
    border-right: 1px solid var(--border-strong);
    min-width: 96px;
  }
  .hs:last-child {
    border-right: none;
  }
  .hs .v {
    font-size: 20px;
    font-weight: 700;
    color: var(--accent);
  }
  .hs .k {
    font-size: 11px;
    color: var(--text-faint);
    margin-top: 2px;
  }

  /* ---- sections ---- */
  .section {
    padding: 64px 0 8px;
  }
  .section-head {
    margin-bottom: 34px;
  }
  .section-head h2 {
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .section-head h2::before {
    content: '// ';
    color: var(--accent);
    font-weight: 400;
  }
  .section-head p {
    margin-top: 10px;
    color: var(--text-dim);
    max-width: 620px;
    font-size: 14.5px;
    font-family: var(--font-sans);
  }

  /* ---- category blocks ---- */
  .cat-block {
    margin-bottom: 44px;
  }
  .cat-head {
    margin-bottom: 18px;
  }
  .cat-head h3 {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .cat-head h3::before {
    content: '▸ ';
    color: var(--accent);
  }
  .cat-head .count {
    color: var(--text-faint);
    font-weight: 400;
  }
  .cat-head p {
    margin-top: 6px;
    color: var(--text-faint);
    font-size: 13px;
    font-family: var(--font-sans);
    max-width: 620px;
  }

  /* ---- card grid ---- */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .skill-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .card {
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-cell);
    padding: 16px 18px 18px;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }
  .card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  .display {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .display.sm {
    font-size: 13.5px;
    overflow-wrap: anywhere;
  }
  .pill {
    font-size: 10.5px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid rgba(69, 224, 168, 0.4);
    border-radius: 20px;
    padding: 2px 10px;
    white-space: nowrap;
  }
  .desc {
    margin-top: 10px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text-dim);
    font-family: var(--font-sans);
  }
  .desc.clamp {
    color: var(--text-faint);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  button.agent-card {
    font: inherit;
    color: inherit;
    text-align: left;
    width: 100%;
    cursor: pointer;
  }
  button.agent-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ---- agent flow modal (hướng C — swimlane) ---- */
  dialog.lane-modal {
    width: min(900px, calc(100vw - 32px));
    max-height: min(86vh, 820px);
    background: var(--bg-raised);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-cell);
    padding: 0;
    box-shadow:
      0 40px 120px rgba(0, 0, 0, 0.6),
      0 0 80px rgba(69, 224, 168, 0.06);
  }
  dialog.lane-modal[open] {
    display: flex;
    flex-direction: column;
  }
  dialog.lane-modal::backdrop {
    background: rgba(4, 20, 13, 0.72);
    backdrop-filter: blur(4px);
  }
  .lm-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
    background: var(--panel);
  }
  .lm-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .lm-name {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .lm-close {
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-btn);
    color: var(--text-dim);
    font: 700 11px var(--font-display);
    padding: 5px 12px;
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .lm-close:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .lm-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .lm-body {
    padding: 20px;
    overflow: auto;
  }
  .lm-caption {
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-dim);
    font-family: var(--font-sans);
    margin-bottom: 16px;
  }
  .lm-caption b {
    color: var(--text);
    font-weight: 600;
  }
  .lm-foot {
    padding: 12px 20px 16px;
    border-top: 1px solid var(--border);
    font-size: 10.5px;
    color: var(--text-faint);
    font-family: var(--font-sans);
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .lm-foot kbd {
    font: 700 10px var(--font-display);
    color: var(--accent);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    padding: 1px 6px;
  }
  .lm-svg-wrap {
    overflow-x: auto;
  }
  .sl-svg {
    width: 100%;
    height: auto;
    display: block;
    min-width: 640px;
  }
  .lane-bg {
    fill: var(--panel);
  }
  .lane-bg.alt {
    fill: var(--panel-2);
  }
  .lane-label {
    font: 700 10px var(--font-display);
    fill: var(--text-faint);
    letter-spacing: 0.08em;
  }
  .sl-node {
    fill: var(--bg-card);
    stroke: var(--border-strong);
  }
  .sl-num-bg {
    fill: var(--accent);
  }
  .sl-num {
    font: 700 8px var(--font-display);
    fill: var(--bg-deep);
  }
  .sl-label {
    font: 700 10px var(--font-display);
    fill: var(--text);
  }
  .sl-edge {
    stroke: var(--border-strong);
    stroke-width: 1.5;
    fill: none;
  }
  .sl-arrow {
    fill: var(--accent-dim);
  }

  /* ---- responsive ---- */
  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .skill-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .wrap {
      padding: 0 20px;
    }
    .grid,
    .skill-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .hs {
      min-width: 88px;
    }
    .pill {
      display: none;
    }
    dialog.lane-modal {
      inset: 0;
      width: 100vw;
      height: 100dvh;
      max-height: none;
      border: none;
      border-radius: 0;
    }
    .lm-svg-wrap {
      overflow-x: auto;
    }
  }

  /* ---- hover lift (same as /skills, touch excluded) ---- */
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      border-color: var(--accent);
      box-shadow:
        0 24px 70px rgba(0, 0, 0, 0.5),
        0 0 40px rgba(69, 224, 168, 0.08);
      transform: translateY(-3px);
    }
  }
</style>

<script>
  // Shared motion contract, same as /skills — nothing custom.
  import { initMotion } from '../components/motion';
  initMotion();

  // Agent flow modal (hướng C) — native <dialog>, mở đúng dialog theo data-agent.
  const agentCards = document.querySelectorAll<HTMLButtonElement>('button.agent-card');
  for (const card of agentCards) {
    card.addEventListener('click', () => {
      const dlg = document.getElementById(`agent-modal-${card.dataset.agent}`);
      if (dlg instanceof HTMLDialogElement) dlg.showModal();
    });
  }
  for (const dlg of document.querySelectorAll<HTMLDialogElement>('dialog.lane-modal')) {
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close(); // backdrop click
    });
    dlg.querySelector('.lm-close')?.addEventListener('click', () => dlg.close());
  }
</script>
