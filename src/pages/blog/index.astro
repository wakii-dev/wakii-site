---
/**
 * EN blog listing — B+C hybrid redesign (story FI-349 SF-3).
 * Shared shell + listing component (source of truth:
 * docs/superpowers/designs/fi349-sf3-direction.md + fi349-sf3-hybrid.html).
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogShell from '../../components/blog/BlogShell.astro';
import BlogListing from '../../components/blog/BlogListing.astro';
import { blogStrings } from '../../components/blog/strings';
import { toCard } from '../../components/blog/cards';
import { SITE_URL } from '../../config';

const locale = 'en' as const;
const strings = blogStrings(locale);
const entries = (
  await getCollection('blog', (b) => b.id.startsWith('en/') && !b.data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = entries.map(toCard);

const categoryCounts: Record<string, number> = { all: posts.length };
for (const p of posts) categoryCounts[p.category] = (categoryCounts[p.category] ?? 0) + 1;
const newest = entries[0] ? entries[0].data.pubDate.toISOString().slice(0, 10) : '';

/** JSON-LD Blog — absolute URLs (spec rev 3 §SF-3; SF-4 validates via scripts/check-jsonld.mjs). */
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Wakii Blog',
  url: `${SITE_URL}/blog/`,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.title,
    datePublished: p.date,
    url: `${SITE_URL}${p.href}`,
  })),
};
---
<Base title={strings.listingTitle} description={strings.description}>
  <BlogShell
    locale={locale}
    strings={strings}
    title="blog"
    subtitle={strings.listingRsub}
    activeCategory={null}
    categoryCounts={categoryCounts}
    metaLine={strings.updated(newest)}
  >
    <BlogListing
      mode="listing"
      locale={locale}
      strings={strings}
      posts={posts}
      lede={strings.listingLede}
      headMeta={`${strings.postsCount(posts.length)} · ${strings.newestFirst}`}
    />
  </BlogShell>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonld).replace(/</g, '\\u003c')} />
</Base>
