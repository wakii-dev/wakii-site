---
/**
 * VI blog post — thin route (FI-349 SF-2), mirror của EN twin: getStaticPaths
 * (draft filter, LOCKED) + render; BlogDetailLayout tự xử lý locale strings
 * (đọc từ prefix `vi/` trong entry id).
 * og contract (pinned, FI-339 rev 2) is wired inside the layout.
 */
import { getCollection, render } from 'astro:content';
import BlogDetailLayout from '../../../layouts/BlogDetailLayout.astro';
import { blogSlug } from '../../../content.config';

export async function getStaticPaths() {
  const entries = await getCollection('blog', (b) => b.id.startsWith('vi/') && !b.data.draft);
  return entries.map((entry) => ({
    params: { slug: blogSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<BlogDetailLayout entry={entry} headings={headings}>
  <Content />
</BlogDetailLayout>
